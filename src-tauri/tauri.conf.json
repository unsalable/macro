{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowMacro",
  "version": "0.3.0",
  "identifier": "com.flowmacro.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "FlowMacro",
        "width": 1180,
        "height": 780,
        "minWidth": 1000,
        "minHeight": 650,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/unsalable/macro/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5RDY0QkUzODFDOUI4NjQKUldSa3VNbUI0MHZXT1g5amZJVVpRRzkxZFVnM2gzWituVmw5MjRORlpyVjVSaEcvMnd1Mk1TdkYK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "FlowMacro",
    "category": "Utility",
    "shortDescription": "Keyboard and mouse automation",
    "longDescription": "FlowMacro records, edits and replays keyboard and mouse macros with precise timing.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Turkish"]
      }
    }
  }
}
